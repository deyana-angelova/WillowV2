@model List<WillowProject.Models.Split>

@{
    ViewData["Title"] = "Split";
    var allParticipants = Model.SelectMany(s => s.Participants).ToList();
    var totalOwed = allParticipants.Sum(p => p.AmountOwed - p.AmountPaid);
    var totalPaid = allParticipants.Sum(p => p.AmountPaid);
}

<div class="px-3 py-3">
    <div class="dash-header">
        <h1 class="hero-title" style="font-size: 2rem;">Splits</h1>
        <div style="flex:1"></div>
        <button type="button" class="action-btn" id="newSplitBtn" data-bs-toggle="modal" data-bs-target="#addSplitModal">           
            New Split
        </button>
    </div>
    <div class="row g-3 mb-4 mt-3">
        <div class="col-6 col-md-4">
            <div class="card text-center shadow-sm">
                <div class="card-body">
                    <div class="text-white-50 small text-uppercase">Still owed</div>
                    <div class="fs-4 fw-bold text-danger">@totalOwed.ToString("C")</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-4">
            <div class="card text-center shadow-sm">
                <div class="card-body">
                    <div class="text-white-50 small text-uppercase">Already paid back</div>
                    <div class="fs-4 fw-bold text-success">@totalPaid.ToString("C")</div>
                </div>
            </div>
        </div>
    </div>

    @if (Model.Count == 0)
    {
        <p style="color: #4b5563; font-size: 13px;">No splits yet. Create one above!</p>
    }
    else
    {
        @foreach (var split in Model)
        {
            <div class="card mb-3 shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div>
                            <h5 class="card-title mb-0 text-white">@split.Name</h5>
                            <div class="text-white-50 small">@split.Date.ToString("MMM dd, yyyy")</div>
                            @if (!string.IsNullOrWhiteSpace(split.Notes))
                            {
                                <div class="text-white-50 small mt-1">@split.Notes</div>
                            }
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <div class="fs-5 fw-bold text-success">@split.TotalAmount.ToString("C")</div>
                            <button type="button" class="btn btn-outline-success btn-sm rounded-circle" onclick="openEditModal('@split.Id')" title="Edit split">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                                    <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" />
                                    <path d="M18.5 2.5a2.1 2.1 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z" />
                                </svg>
                            </button>
                        </div>
                    </div>

                    @if (split.Participants.Count > 0)
                    {
                        <ul class="list-group list-group-flush mb-2">
                            @foreach (var participant in split.Participants)
                            {
                                var remaining = participant.AmountOwed - participant.AmountPaid;
                                <li class="list-group-item bg-transparent d-flex justify-content-between align-items-center flex-wrap gap-2">
                                    <div>
                                        <div class="fw-semibold text-white">@participant.Name</div>
                                        <div class="text-white-50 small">
                                            @participant.AmountPaid.ToString("C") of @participant.AmountOwed.ToString("C") paid
                                        </div>
                                    </div>
                                    <div class="d-flex align-items-center gap-2">
                                        @if (remaining <= 0)
                                        {
                                            <span class="badge text-bg-success rounded-pill">Paid in full</span>
                                        }
                                        else
                                        {
                                            <input type="number" step="1" min="0" max="@participant.AmountOwed"
                                                   class="form-control form-control-sm" style="width: 90px;"
                                                   id="pay-@participant.Id" value="@participant.AmountPaid" />
                                            <button type="button" class="btn btn-success btn-sm rounded-pill" onclick="updatePayment('@participant.Id')">Update</button>
                                        }
                                    </div>
                                </li>
                            }
                        </ul>
                    }

                    <button type="button" class="btn btn-link text-danger p-0" onclick="deleteSplit('@split.Id')">Delete Split</button>
                </div>
            </div>
        }

    }
</div>

@* Add / Edit Split Modal (shared) *@
<div class="modal fade" id="addSplitModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="splitModalTitle">New Split</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="addSplitForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="editSplitId" value="" />

                    <div class="mb-3">
                        <label class="form-label">Name</label>
                        <input type="text" class="form-control" name="Name" id="splitName" placeholder="e.g. Dinner, Electricity" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Total Amount</label>
                        <input type="number" step="0.01" class="form-control" name="TotalAmount" id="splitTotal" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Date</label>
                        <input type="date" class="form-control" name="Date" id="splitDate" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Notes</label>
                        <textarea class="form-control" name="Notes" id="splitNotes"></textarea>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Participants</label>
                        <div id="participantsList"></div>
                        <button type="button" class="jar-move-btn" onclick="addParticipant()">+ Add Participant</button>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="submitSplit">Save</button>
            </div>
        </div>
    </div>
</div>

<style>

    .split-summary-card, .split-card {
        border-radius: 12px;
        padding: 16px 20px;
    }

    .split-summary-label {
        color: #ffffff;
    }

    .split-summary-amount {
        font-size: 22px;
        font-weight: 600;
    }

        .split-summary-amount.owed {
            color: #ff8a80;
        }

        .split-summary-amount.paid, .split-total, .split-date {
            color: #74c69d;
        }

    .split-name, .participant-name {
        color: #eafaf1;
        font-weight: 600;
    }

    .split-card {
        margin-bottom: 16px;
    }

    .split-card-header {
        display: flex;
        justify-content: space-between;
        margin-bottom: 12px;
    }

    .split-participant {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 10px 12px;
        border-radius: 8px;
        background: rgba(116, 198, 157, 0.08);
        margin-bottom: 8px;
    }

    .payment-input {
        background: #0d2a1c;
        border: 1px solid rgba(116, 198, 157, 0.3);
        border-radius: 8px;
        color: #eafaf1;
        padding: 6px 8px;
    }

    .participant-markpaid, .split-edit-btn {
        background: #2d6a4f;
        border: 1px solid #74c69d;
        color: #ffffff;
        border-radius: 8px;
        padding: 6px 14px;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.15s;
    }

        .participant-markpaid:hover, .split-edit-btn:hover {
            background: #74c69d;
            color: #1a3d2b;
        }

    .split-delete {
        color: #ff8a80;
        background: none;
        border: none;
        cursor: pointer;
    }

    .action-btn {
        background: #74c69d;
        color: white;
        border: none;
        border-radius: 50px;
        padding: 10px 18px;
        font-weight: 600;
        cursor: pointer;
        transition: 0.2s ease;
    }
</style>
<script>
    // index always starts at 0 and stays consecutive — required for ASP.NET model binding of lists
    let participantCount = 0;

    function reindexParticipants() {
        const rows = document.querySelectorAll('#participantsList .participant-row');
        rows.forEach((row, i) => {
            row.querySelector('.p-name').name = `Participants[${i}].Name`;
            row.querySelector('.p-owed').name = `Participants[${i}].AmountOwed`;
            row.querySelector('.p-paid').name = `Participants[${i}].AmountPaid`;
        });
        participantCount = rows.length;
    }

    function addParticipant(name = '', owed = '', paid = 0) {
        const list = document.getElementById('participantsList');
        const row = document.createElement('div');
        row.className = 'participant-row';
        row.style.cssText = 'display:flex; gap:8px; margin-bottom:8px;';
        row.innerHTML = `
            <input type="text" class="form-control p-name" placeholder="Name" value="${name}" required />
            <input type="number" step="0.01" class="form-control p-owed" placeholder="Owed" value="${owed}" required />
            <input type="number" step="0.01" class="form-control p-paid" placeholder="Paid so far" value="${paid}" />
            <button type="button" onclick="this.parentElement.remove(); reindexParticipants();" style="background:none; border:none; color:#f87171; cursor:pointer;">✕</button>
        `;
        list.appendChild(row);
        reindexParticipants();
    }

    // reset the form when opening in "add" mode
    document.getElementById('newSplitBtn').addEventListener('click', () => {
        document.getElementById('splitModalTitle').textContent = 'New Split';
        document.getElementById('editSplitId').value = '';
        document.getElementById('addSplitForm').reset();
        document.getElementById('participantsList').innerHTML = '';
        participantCount = 0;
    });

    //open modal in "edit" mode, pre-filled with existing data
    async function openEditModal(id) {
        const response = await fetch(`/Split/GetSplit?id=${id}`);
        if (!response.ok) {
            alert('Could not load split.');
            return;
        }
        const split = await response.json();

        document.getElementById('splitModalTitle').textContent = 'Edit Split';
        document.getElementById('editSplitId').value = split.id;
        document.getElementById('splitName').value = split.name;
        document.getElementById('splitTotal').value = split.totalAmount;
        document.getElementById('splitDate').value =
    split.date ? split.date.substring(0, 10) : '';
        document.getElementById('splitNotes').value = split.notes ?? '';

        document.getElementById('participantsList').innerHTML = '';
        participantCount = 0;
        split.participants.forEach(p => addParticipant(p.name, p.amountOwed, p.amountPaid));

        new bootstrap.Modal(document.getElementById('addSplitModal')).show();
    }

    //submit — handles both creating a new split and saving edits
    document.getElementById('submitSplit').addEventListener('click', async () => {
        const form = document.getElementById('addSplitForm');
        const data = new FormData(form);
        const editId = document.getElementById('editSplitId').value;

        const url = editId ? `/Split/Edit?id=${editId}` : '/Split/Add';

        const response = await fetch(url, {
            method: 'POST',
            body: data,
            headers: {
                'RequestVerificationToken': document.querySelector('[name=__RequestVerificationToken]').value
            }
        });

        if (response.ok) {
            bootstrap.Modal.getInstance(document.getElementById('addSplitModal')).hide();
            location.reload();
        } else {
            const text = await response.text();
            alert('Something went wrong: ' + text);
        }
    });

    //update how much a participant has paid back so far
    async function updatePayment(participantId) {
        const input = document.getElementById(`pay-${participantId}`);
        const amountPaid = input.value;

        const response = await fetch('/Split/UpdatePayment', {
            method: 'POST',
            body: new URLSearchParams({ id: participantId, amountPaid }),
            headers: {
                'RequestVerificationToken': document.querySelector('[name=__RequestVerificationToken]').value
            }
        });

        if (response.ok) {
            location.reload();
        } else {
            const text = await response.text();
            alert(text);
        }
    }

    async function deleteSplit(id) {
        if (!confirm('Are you sure you want to delete this split?')) return;

        const response = await fetch('/Split/Delete', {
            method: 'POST',
            body: new URLSearchParams({ id }),
            headers: {
                'RequestVerificationToken': document.querySelector('[name=__RequestVerificationToken]').value
            }
        });
        if (response.ok) location.reload();
    }
</script>
