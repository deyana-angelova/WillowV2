@{
}
@model WillowV2.Models.FinTransaction
@using WillowV2.Models.Enums
<h1>Edit a transaction</h1>
@if(Model is null)
{
    <p>Error! No transaction was found with this ID!</p>
}
else
{
    <form method="post">
        <div class="mt-3">
            <label class="form-label">Id</label>
            <input type="text" class="form-control" asp-for="Id" readonly>
        </div>
        <div class="mt-3">
            <label class="form-label">Name</label>
            <input type="text" class="form-control" asp-for="Name">
        </div>
        <div class="mt-3">
            <label class="form-label">Amount</label>
            <input type="text" class="form-control" asp-for="Amount">
        </div>
        <div class="mt-3">
            <label class="form-label">Date</label>
            <input type="text" class="form-control" asp-for="Date">
        </div>
        <div class="mt-3">
            <label class="form-label">Category</label>
            <select class="form-control" asp-for="CategoryId">
                @foreach (var category in (List<WillowV2.Models.FinCategory>)ViewBag.Categories)
                {
                    <option value="@category.Id">@category.Name (@category.Type)</option>
                }
            </select>
        </div>
        <div class="mt-3">
            <label class="form-label">Notes</label>
            <input type="text" class="form-control" asp-for="Notes">
        </div>
        <div class="mt-3">
            <button type="submit" class="btn btn-primary">Save</button>
        </div>
        <div class="mt-3">
            <button type="submit" class="btn btn-danger ms-3" asp-action="Delete" asp-controller="Transaction">Delete</button>
        </div>
    </form>
    
}

<style>
    .form-label{
        color: white;
    }

</style>