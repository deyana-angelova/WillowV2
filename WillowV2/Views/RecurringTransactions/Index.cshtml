@model IEnumerable<WillowV2.Models.RecurringTransaction>

@{
    ViewData["Title"] = "Recurring Transactions";
}

<div class="dashboard-container p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="hero-title" style="font-size: 2rem;">Recurring Transactions</h1>
        <button type="button" class="btn" style="background:#74c69d; color:#05150d; font-weight:600;"
                data-bs-toggle="modal" data-bs-target="#addRecurringModal">
            + New Recurring Transaction
        </button>
    </div>

    @if (!Model.Any())
    {
        <div class="card p-4">
            <p class="text-muted mb-0">No recurring transactions yet. Add one to get started.</p>
        </div>
    }
    else
    {
        <table class="table">
            <thead>
                <tr>
                    <th style="width: 20%;">Name</th>
                    <th style="width: 15%;">Amount</th>
                    <th style="width: 15%;">Day of Month</th>
                    <th style="width: 20%;">Category</th>
                    <th style="width: 15%;">Last Processed</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Name</td>
                        <td>@item.Amount.ToString("C")</td>
                        <td>@item.DayOfMonth</td>
                        <td>@item.Category?.Name</td>
                        <td>@(item.LastProcessed?.ToShortDateString() ?? "Never")</td>
                        <td style="background: transparent !important; border: none;">
                            <a class="btn btn-primary btn-sm" style="width: 70px;" asp-controller="RecurringTransactions" asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                            <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline">
                                <button type="submit" class="btn btn-danger btn-sm" style="width: 70px;">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

<!-- Add Recurring Transaction Modal -->
<div class="modal fade" id="addRecurringModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="Add" method="post">
                <div class="modal-header" style="border-bottom: 1px solid rgba(116,198,157,0.2);">
                    <h5 class="modal-title">New Recurring Transaction</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label" style="color:#74c69d;">Name</label>
                        <input name="name" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" style="color:#74c69d;">Amount</label>
                        <input name="amount" type="number" step="0.01" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" style="color:#74c69d;">Day of Month</label>
                        <input name="dayOfMonth" type="number" min="1" max="31" class="form-control" required />
                        <div class="form-text" style="color:#9fcdb8;">
                            If a month has fewer days, it'll run on that month's last day instead.
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" style="color:#74c69d;">Category</label>
                        <select name="categoryId" class="form-select" required>
                            <option value="">-- Select a category --</option>
                            @foreach (var c in (IEnumerable<WillowV2.Models.FinCategory>)ViewBag.Categories)
                            {
                                <option value="@c.Id">@c.Name</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="modal-footer" style="border-top: 1px solid rgba(116,198,157,0.2);">
                    <button type="button" class="btn btn-link" style="color:#74c69d;" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn" style="background:#74c69d; color:#05150d; font-weight:600;">Add</button>
                  
                </div>    
            </form>
        </div>
    </div>
</div>