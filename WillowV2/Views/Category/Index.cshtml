@{
}
@{
    ViewData["Title"] = "Categories";
}
@model List<WillowV2.Models.FinCategory>
<div class="dashboard-container p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="hero-title" style="font-size: 2rem;">Categories</h1>
        <button type="button" class="btn" style="background:#74c69d; color:#05150d; font-weight:600;"
                data-bs-toggle="modal" data-bs-target="#addCategoryModal">
            + New Category
        </button>
    </div>

<table class="table">
    <thead>
        <tr>
                <th style="width: 50%;">Name</th>
                <th style="width: 50%;">Type</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var category in Model)
        {
            <tr>
                <td>@category.Name</td>
                <td>@category.Type</td>
                    <td style="background: transparent !important; border: none;">
                        <div class="d-flex gap-2">
                            <a class="btn btn-primary btn-sm" style="width: 70px;" asp-controller="Category" asp-action="Edit" asp-route-id="@category.Id">Edit</a>
                            <form asp-action="Delete" asp-route-id="@category.Id" method="post" class="m-0">
                                <button type="submit" class="btn btn-danger btn-sm" style="width: 70px;">Delete</button>
                            </form>
                        </div>
                    </td>
            </tr>
        }
    </tbody>
</table>
</div>
    <!-- Add Category Modal -->
    <div class="modal fade" id="addCategoryModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                 <form asp-action="Add" method="post">
                    <div class="modal-header" style="border-bottom: 1px solid rgba(116,198,157,0.2);">
                        <h5 class="modal-title">New Category</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                        <div class="modal-body">
                            <div class="mb-3">
                                <label class="form-label" style="color:#74c69d;">Name</label>
                                <input name="name" class="form-control" required />
                            </div>
                            <div class="mb-3">
                        <label class="form-label" style="color:#74c69d;">Type</label>
                        <select name="type" class="form-select" required>
                            <option value="0">Income</option>
                            <option value="1">Expense</option>
                        </select>
                            </div>
                        </div>
                    
                    <div class="modal-footer" style="border-top: 1px solid rgba(116,198,157,0.2);">
                        <button type="button" class="btn btn-link" style="color:#74c69d;" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn" style="background:#74c69d; color:#05150d; font-weight:600;">Add</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
<style>
    .form-select, .form-control {
        background-color: #0d2818;
        border: 1px solid rgba(116, 198, 157, 0.3);
        color: #74c69d;
    }

        .form-select:focus, .form-control:focus {
            background-color: #0d2818;
            border-color: #74c69d;
            color: #74c69d;
            box-shadow: 0 0 0 0.25rem rgba(116, 198, 157, 0.15);
        }

        .form-select option {
            background-color: #0d2818;
            color: #74c69d;
        }

        .modal {
            z-index: 1055 !important;
        }

        .modal-backdrop {
            z-index: 1050 !important;
        }
</style>