@* Update goal's current amount form *@
<div class="modal fade" id="updateGoalModal" tabindex="-1" aria-labelledby="updateGoal" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="updateGoal">Update goal's current amount</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="updateGoalForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="goalId" id="updateGoalId"/>
                    <div class="mb-3">
                        <label class="form-label">Amount*</label>
                        <input type="number" step="0.01" class="form-control" name="amount" id="updateGoalAmount" required />
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="submitAddToGoal">Save</button>
            </div>
        </div>
    </div>
</div>
@* Scan receipt (phone only) *@
<div class="d-block d-md-none mt-3">
    <button class="btn btn-success w-100" id="scanReceiptBtn">
        📷 Scan Receipt
    </button>
    <input type="file" id="receiptImage" accept="image/*" capture="environment" style="display:none" />
</div>
<div class="modal fade" id="receiptReviewModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Review Receipt Items</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div id="scanStatus" class="text-center text-muted mb-3" style="display:none">
                    <div class="spinner-border spinner-border-sm me-2"></div>
                    Reading receipt ...
                </div>
                <div id="receiptItems"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-success" id="saveReceiptItems">Save All</button>
            </div>
        </div>
    </div>
</div>

<script>
    document.getElementById('scanReceiptBtn').addEventListener('click', function() {
        document.getElementById('receiptImage').click();
        });
        //add goal
    const goalSaveBtn = document.getElementById('submitGoal');

    goalSaveBtn.addEventListener('click', async function(){
        const formGoal = document.getElementById('addGoalForm');
        const formData = new FormData(formGoal);

        const response = await fetch ('/Goal/Add', {
            method: 'POST',
            body: formData,
            headers: {
                'RequestVerificationToken': document.querySelector('[name=__RequestVerificationToken]').value
            }
        });

            if (response.ok) {
            bootstrap.Modal.getInstance(document.getElementById('addGoalModal')).hide();
            location.reload();
        } else {
            const errorText = await response.text();
            alert(errorText);
        }
    });
    //add income
    const addEarningBtn = document.getElementById('submitEarnings');

    addEarningBtn.addEventListener('click', async function(){
    const formEarnings = document.getElementById('addEarningsForm');
    const formDataEarning = new FormData(formEarnings);

    const response = await fetch('/Transaction/Add', {
        method: 'POST',
        body: formDataEarning,
        headers: {
                'RequestVerificationToken': document.querySelector('[name=__RequestVerificationToken]').value
         }
        });
     if (response.ok) {
            bootstrap.Modal.getInstance(document.getElementById('addEarningsModal')).hide();
            location.reload();
        } else {
            const errorText = await response.text();
            alert(errorText);
        }
           });
           //add expense
           const addExpenseBtn = document.getElementById('submitExpense');

           addExpenseBtn.addEventListener('click', async function(){
               const formExpenses = document.getElementById('addExpenseForm');
               const formDataExpenses = new FormData(formExpenses);

               const response = await fetch('/Transaction/Add',{
                   method: 'POST',
                   body: formDataExpenses,
                   headers: {
                        'RequestVerificationToken': document.querySelector('[name=__RequestVerificationToken]').value
                   }
               });
                 if (response.ok) {
            bootstrap.Modal.getInstance(document.getElementById('addExpenseModal')).hide();
            location.reload();
        } else {
            const errorText = await response.text();
            alert(errorText);
        }
           });

           //add to savings
           const addSavingsBtn = document.getElementById('submitSavings');

           addSavingsBtn.addEventListener('click', async function(){
               const formSavings = document.getElementById('addToSavingsForm');
               const formDataSavings = new FormData(formSavings);

               const response = await fetch('/Savings/Add', {
                   method: 'POST',
                   body: formDataSavings,
                   headers:  {
                        'RequestVerificationToken': document.querySelector('[name=__RequestVerificationToken]').value
                   }
               });
           if (response.ok) {
               bootstrap.Modal.getInstance(document.getElementById('addToSavingsModal')).hide();
               location.reload();
           } else {
               const errorText = await response.text();
               alert(errorText);
           }
           });
               //withdraw savings
    const withdrawSavingsBtn = document.getElementById('submitWithdrawSavings');

    withdrawSavingsBtn.addEventListener('click', async function(){
        const formWithdraw = document.getElementById('withdrawSavingsForm');
        const formDataWithdraw = new FormData(formWithdraw);

        const response = await fetch('/Savings/Withdraw', {
            method: 'POST',
            body: formDataWithdraw,
            headers: {
                'RequestVerificationToken': document.querySelector('[name=__RequestVerificationToken]').value
            }
        });
        if (response.ok) {
            bootstrap.Modal.getInstance(document.getElementById('withdrawSavingsModal')).hide();
            location.reload();
        } else {
            const errorText = await response.text();
            alert(errorText);
        }
    });
           //update goal funds
           document.getElementById('submitAddToGoal').addEventListener('click', async function () {
               const goalId = document.getElementById('updateGoalId').value;
               const amount = document.getElementById('updateGoalAmount').value;
               const token = document.querySelector('#updateGoalForm input[name="__RequestVerificationToken"]').value;

              const formData = new URLSearchParams();
              formData.append('goalId', goalId);
              formData.append('amount', amount);

            const response = await fetch('/Goal/AddToGoal', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                'RequestVerificationToken': token
           },
            body: formData.toString()
            });
            if (response.ok) {
                location.reload();
            } else {
                alert('Failed to update goal.');
            }
           });
</script>

<script>

    const expenseCategories =
        @Html.Raw(Json.Serialize(ViewBag.ExpenseCategories));

    const expenseAmounts =
        @Html.Raw(Json.Serialize(ViewBag.ExpenseAmounts));

    const incomeCategories =
        @Html.Raw(Json.Serialize(ViewBag.IncomeCategories));

    const incomeAmounts =
        @Html.Raw(Json.Serialize(ViewBag.IncomeAmounts));

    const expenseMonths =
        @Html.Raw(Json.Serialize(ViewBag.ExpenseMonths));

    const expenseMonthAmounts =
        @Html.Raw(Json.Serialize(ViewBag.ExpenseMonthAmounts));


    let dashboardChart;

    function createChart(type) {

        if (dashboardChart) {
            dashboardChart.destroy();
        }

        let labels;
        let amounts;
        let chartType;

        if (type === "expenses") {
            labels = expenseCategories;
            amounts = expenseAmounts;
            chartType = "pie";
        }

        else if (type === "income") {
            labels = incomeCategories;
            amounts = incomeAmounts;
            chartType = "pie";
        }

        else if (type === "monthly") {
            labels = expenseMonths;
            amounts = expenseMonthAmounts;
            chartType = "bar";
        }

        dashboardChart = new Chart(
            document.getElementById("dashboardChart"),
            {
                type: chartType,

                data: {
                    labels: labels,

                    datasets: [{
                        label: "Amount",
                        data: amounts
                    }]
                },

                options: {
                    responsive: true,
                    maintainAspectRatio: false,

                    plugins: {
                        legend: {
                            labels: {
                                color: "white"
                            }
                        }
                    },

                    scales: chartType === "bar" ? {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                color: "white"
                            }
                        },
                        x: {
                            ticks: {
                                color: "white"
                            }
                        }
                    } : {}
                }
            }
        );
    }


    // Initial chart
    createChart("expenses");


    // Dropdown
    document.getElementById("chartSelector")
        .addEventListener("change", function () {

            createChart(this.value);

        });

</script>
<style>
