    }

    .td4 {
        animation: d1 4.7s ease-in-out infinite;
        transform-origin: 50% 0%;
        animation-delay: 0.9s;
    }

    .td5 {
        animation: d2 5.5s ease-in-out infinite;
        transform-origin: 50% 0%;
        animation-delay: 0.2s;
    }

    .td6 {
        animation: d3 4.0s ease-in-out infinite;
        transform-origin: 50% 0%;
        animation-delay: 0.5s;
    }

    .td7 {
        animation: d1 5.2s ease-in-out infinite;
        transform-origin: 50% 0%;
        animation-delay: 0.8s;
    }

    .td8 {
        animation: d2 3.9s ease-in-out infinite;
        transform-origin: 50% 0%;
