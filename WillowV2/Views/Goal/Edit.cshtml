@{
}
@model WillowV2.Models.Goal

<h1>Edit a goal</h1>
@if (Model is null)
{
    <p>Error! No goal was found with this ID!</p>
}
else
{
    <form method="post">
        <div class="mt-3">
            <label class="form-label">Id</label>
            <input type="text" class="form-control" asp-for="Id" readonly>
        </div>
        <div class="mt-3">
            <label class="form-label">Name</label>
            <input type="text" class="form-control" asp-for="Name">
        </div>
        <div class="mt-3">
            <label class="form-label">Amount to reach</label>
            <input type="text" class="form-control" asp-for="AmountToReach">
        </div>
        <div class="mt-3">
            <label class="form-label">Current amount</label>
            <input type="text" class="form-control" asp-for="CurrentAmount">
        </div>
        <div class="mt-3">
            <label class="form-label">Current date</label>
            <input type="text" class="form-control" asp-for="CurrentDate">
        </div>
        <div class="mt-3">
            <label class="form-label">Deadline</label>
            <input type="text" class="form-control" asp-for="Deadline">
        </div>
        <div class="mt-3">
            <label class="form-label">Notes</label>
            <input type="text" class="form-control" asp-for="Notes">
        </div>
        <div class="mt-3">
            <button type="submit" class="btn btn-primary">Save</button>
        </div>
        <div class="mt-3">
            <button type="submit" class="btn btn-danger ms-3" asp-action="Delete" asp-controller="Goal">Delete</button>
        </div>
    </form>

}
<style>
     .form-label {
         color: white;
     }

</style>